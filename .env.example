# Test-only values for the local Compose stack (docs/local-stack.md). Nothing here protects real data:
# the stack listens on 127.0.0.1 and holds nothing between `docker compose down --volumes` runs.
# Copy this file to .env to change a value. Never put a real credential in either file.

# The PostgreSQL superuser. Only the first start of the database uses it.
POSTGRES_PASSWORD=local-dev-only-postgres-admin
# The migration role owns the schema. Only the migrate service connects as it.
IPSO_MIGRATE_PASSWORD=local-dev-only-migration-role
# The application role. The api service and the seed connect as it. It owns nothing and cannot
# bypass row-level security.
IPSO_APP_PASSWORD=local-dev-only-application-role

# The secrets of the two OIDC clients of the local provider, and its one test user.
IPSO_API_CLIENT_SECRET=local-dev-only-api-client
IPSO_OTHER_CLIENT_SECRET=local-dev-only-other-client
IPSO_DEX_USER=dev
IPSO_DEX_PASSWORD=local-dev-only-user-login

# The tenant the stack serves, and the person its test user logs in as.
IPSO_TENANT_ID=00000000-0000-4000-8000-000000000001
IPSO_SEED_PRINCIPAL_ID=00000000-0000-4000-8000-0000000000a1
# The subject of that user in a Dex token. Dex derives it from the user id of its mock connector and
# the connector id (dev): base64url of the two as a protobuf message.
IPSO_SEED_SUBJECT=Cg0wLTM4NS0yODA4OS0wEgNkZXY
