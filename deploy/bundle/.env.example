# Required values for the Compose bundle. Every value is empty on purpose: Compose refuses to
# start until you set one. Do not put a real credential in this file. Copy it to .env and fill that.

# Superuser of PostgreSQL. Only the first start of the database uses it.
POSTGRES_PASSWORD=
# Owner of the schema. Only the migrate service receives it.
IPSO_MIGRATE_PASSWORD=
# Application role. The api, the worker, and bootstrap connect as it.
IPSO_APP_PASSWORD=

# The one tenant this stack serves, as a UUID.
IPSO_TENANT_ID=
# https issuer the api discovers at start. This stack does not run an identity provider.
IPSO_OIDC_ISSUER=
# Client id the api accepts as the token audience.
IPSO_API_AUDIENCE=

# Used only by `docker compose --profile bootstrap run --rm bootstrap`.
IPSO_TENANT_NAME=
IPSO_PERSON_ID=
IPSO_PERSON_NAME=
IPSO_OIDC_SUBJECT=
# Base64 of exactly 32 bytes. `openssl rand -base64 32` makes one. Delete it from the host
# after bootstrap has succeeded if you do not need to run bootstrap again.
IPSO_TENANT_KEK=
