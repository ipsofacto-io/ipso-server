{
  "steps": [
    {"mark": "t-start"},

    {"tenant": "a", "scope": "a:acme", "kind": "org", "selector": "acme"},
    {"tenant": "a", "scope": "a:payments-domain", "parent": "a:acme", "kind": "domain", "selector": "payments"},
    {"tenant": "a", "scope": "a:billing-service", "parent": "a:payments-domain", "kind": "service", "selector": "billing"},
    {"tenant": "a", "scope": "a:payments-repo", "parent": "a:billing-service", "kind": "repo", "selector": "acme/payments"},
    {"tenant": "a", "scope": "a:infra-path", "parent": "a:payments-repo", "kind": "path", "selector": "infra/**"},
    {"tenant": "a", "scope": "a:infra-prod", "parent": "a:infra-path", "kind": "env", "selector": "prod"},
    {"tenant": "a", "scope": "a:org-prod", "parent": "a:acme", "kind": "env", "selector": "prod"},
    {"tenant": "a", "scope": "a:other-repo", "parent": "a:acme", "kind": "repo", "selector": "acme/other"},
    {"tenant": "a", "scope": "a:glob-repo", "parent": "a:acme", "kind": "repo", "selector": "acme/infra-*"},
    {"tenant": "a", "scope": "a:glob-tf", "parent": "a:glob-repo", "kind": "path", "selector": "**/*.tf"},
    {"tenant": "a", "scope": "a:labs-domain", "parent": "a:acme", "kind": "domain", "selector": "labs"},

    {"tenant": "b", "scope": "b:acme", "kind": "org", "selector": "acme"},
    {"tenant": "b", "scope": "b:payments-repo", "parent": "b:acme", "kind": "repo", "selector": "acme/payments"},

    {"tenant": "a", "decision": "d-org", "scopes": ["a:acme"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-domain", "scopes": ["a:payments-domain"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-service", "scopes": ["a:billing-service"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-repo", "scopes": ["a:payments-repo"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-path", "scopes": ["a:infra-path"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-path-env", "scopes": ["a:infra-prod"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-org-env", "scopes": ["a:org-prod"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-other", "scopes": ["a:other-repo"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-glob", "scopes": ["a:glob-repo"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-glob-tf", "scopes": ["a:glob-tf"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-labs", "scopes": ["a:labs-domain"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-overlap", "scopes": ["a:payments-repo", "a:payments-domain", "a:acme"], "valid": "[2026-01-01,)"},
    {"tenant": "a", "decision": "d-bounded", "scopes": ["a:acme"], "valid": "[2026-02-01,2026-04-01)"},
    {"tenant": "a", "decision": "d-removed", "scopes": ["a:acme"], "valid": "[2026-01-01,)"},
    {"tenant": "b", "decision": "b-org", "scopes": ["b:acme"], "valid": "[2026-01-01,)"},
    {"tenant": "b", "decision": "b-repo", "scopes": ["b:payments-repo"], "valid": "[2026-01-01,)"},

    {"mark": "t0"},
    {"tenant": "a", "decision": "d-late", "scopes": ["a:acme"], "valid": "[2026-04-01,)"},
    {"mark": "t1"},
    {"correct": "d-late", "valid": "[2026-03-01,)"},
    {"mark": "t2"},
    {"remove": "d-removed"},
    {"mark": "t3"},
    {"tenant": "a", "scope": "a:late-repo", "parent": "a:payments-domain", "kind": "repo", "selector": "acme/late"}
  ],
  "queries": [
    {"name": "nothing was known before the first write", "tenant": "a", "repo": "acme/payments", "valid": "2026-05-01", "known": "t-start", "want": []},

    {"name": "a nested chain: org, domain, service, repo, path, and env", "tenant": "a", "repo": "acme/payments", "path": "infra/main.tf", "env": "prod", "valid": "2026-05-01",
      "want": ["d-org", "d-domain", "d-service", "d-repo", "d-path", "d-path-env", "d-org-env", "d-overlap", "d-late@2"]},
    {"name": "another env drops the env scopes", "tenant": "a", "repo": "acme/payments", "path": "infra/main.tf", "env": "dev", "valid": "2026-05-01",
      "want": ["d-org", "d-domain", "d-service", "d-repo", "d-path", "d-overlap", "d-late@2"]},
    {"name": "another path drops the path scope and the env scope under it", "tenant": "a", "repo": "acme/payments", "path": "app/main.go", "env": "prod", "valid": "2026-05-01",
      "want": ["d-org", "d-domain", "d-service", "d-repo", "d-org-env", "d-overlap", "d-late@2"]},
    {"name": "an omitted path and env widen the answer", "tenant": "a", "repo": "acme/payments", "valid": "2026-05-01",
      "want": ["d-org", "d-domain", "d-service", "d-repo", "d-path", "d-path-env", "d-org-env", "d-overlap", "d-late@2"]},
    {"name": "mixed case repo and env are lowercased", "tenant": "a", "repo": "Acme/Payments", "path": "infra/main.tf", "env": "PROD", "valid": "2026-05-01",
      "want": ["d-org", "d-domain", "d-service", "d-repo", "d-path", "d-path-env", "d-org-env", "d-overlap", "d-late@2"]},

    {"name": "a repo with no scope gets only the org scopes", "tenant": "a", "repo": "acme/billing", "path": "x/y", "env": "prod", "valid": "2026-05-01",
      "want": ["d-org", "d-org-env", "d-overlap", "d-late@2"]},
    {"name": "a repo with no scope and another env", "tenant": "a", "repo": "acme/billing", "path": "x/y", "env": "dev", "valid": "2026-05-01",
      "want": ["d-org", "d-overlap", "d-late@2"]},
    {"name": "a sibling repo under the org", "tenant": "a", "repo": "acme/other", "env": "prod", "valid": "2026-05-01",
      "want": ["d-org", "d-org-env", "d-other", "d-overlap", "d-late@2"]},
    {"name": "a glob repo and a path glob under it", "tenant": "a", "repo": "acme/infra-prod", "path": "envs/prod/main.tf", "env": "prod", "valid": "2026-05-01",
      "want": ["d-org", "d-org-env", "d-glob", "d-glob-tf", "d-overlap", "d-late@2"]},
    {"name": "a glob repo and a path the glob does not match", "tenant": "a", "repo": "acme/infra-prod", "path": "README.md", "env": "prod", "valid": "2026-05-01",
      "want": ["d-org", "d-org-env", "d-glob", "d-overlap", "d-late@2"]},
    {"name": "a glob repo with no path widens to the path scope", "tenant": "a", "repo": "acme/infra-prod", "env": "prod", "valid": "2026-05-01",
      "want": ["d-org", "d-org-env", "d-glob", "d-glob-tf", "d-overlap", "d-late@2"]},
    {"name": "a domain with no repo applies to nothing", "tenant": "a", "repo": "acme/labs-tool", "env": "prod", "valid": "2026-05-01",
      "want": ["d-org", "d-org-env", "d-overlap", "d-late@2"]},
    {"name": "another org gets nothing", "tenant": "a", "repo": "other/payments", "env": "prod", "valid": "2026-05-01", "want": []},

    {"name": "tenant B sees its own decisions only", "tenant": "b", "repo": "acme/payments", "env": "prod", "valid": "2026-05-01", "want": ["b-org", "b-repo"]},
    {"name": "tenant B on a repo with no scope", "tenant": "b", "repo": "acme/billing", "valid": "2026-05-01", "want": ["b-org"]},

    {"name": "valid time before any bounded decision", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-01-15",
      "want": ["d-org", "d-org-env", "d-overlap"]},
    {"name": "valid time at the lower bound is inside", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-02-01",
      "want": ["d-org", "d-org-env", "d-overlap", "d-bounded"]},
    {"name": "valid time in the corrected month", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-03-31",
      "want": ["d-org", "d-org-env", "d-overlap", "d-bounded", "d-late@2"]},
    {"name": "valid time at the upper bound is outside", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-04-01",
      "want": ["d-org", "d-org-env", "d-overlap", "d-late@2"]},

    {"name": "as known before the decisions were written, in the corrected month", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-03-15", "known": "t-start", "want": []},
    {"name": "as known at t0, in the corrected month", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-03-15", "known": "t0",
      "want": ["d-org", "d-org-env", "d-overlap", "d-bounded", "d-removed"]},
    {"name": "as known at t1, the late decision starts in April", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-03-15", "known": "t1",
      "want": ["d-org", "d-org-env", "d-overlap", "d-bounded", "d-removed"]},
    {"name": "as known at t1, in May", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-05-01", "known": "t1",
      "want": ["d-org", "d-org-env", "d-overlap", "d-removed", "d-late@1"]},
    {"name": "as known at t2, the correction applies from March", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-03-15", "known": "t2",
      "want": ["d-org", "d-org-env", "d-overlap", "d-bounded", "d-removed", "d-late@2"]},
    {"name": "as known at t2, a decision that is removed later is still there", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-05-01", "known": "t2",
      "want": ["d-org", "d-org-env", "d-overlap", "d-removed", "d-late@2"]},
    {"name": "as known at t3, the removed decision is gone", "tenant": "a", "repo": "acme/billing", "env": "prod", "valid": "2026-05-01", "known": "t3",
      "want": ["d-org", "d-org-env", "d-overlap", "d-late@2"]},

    {"name": "a repo added after t3 is not in the answer as known at t3", "tenant": "a", "repo": "acme/late", "env": "prod", "valid": "2026-05-01", "known": "t3",
      "want": ["d-org", "d-org-env", "d-overlap", "d-late@2"]},
    {"name": "a repo added after t3 brings the domain decision now", "tenant": "a", "repo": "acme/late", "env": "prod", "valid": "2026-05-01",
      "want": ["d-org", "d-domain", "d-org-env", "d-overlap", "d-late@2"]}
  ]
}
