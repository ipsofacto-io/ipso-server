        "added": "// field\n",
        "deny": false
      }
    ],
    "holdout": [
      {
        "tool": "write",
        "path": "internal/rpc/users.pb.go",
        "content": "package rpc\n",
        "added": "package rpc\n",
        "deny": true
      },
      {
        "tool": "write",
        "path": "internal/rpc/users.go",
        "content": "package rpc\n",
        "added": "package rpc\n",
        "deny": false
      }
    ],
    "reference": {
      "rules": [
        {
          "when": [
            {
              "field": "path",
              "op": "suffix",
              "value": ".pb.go"
            }
          ],
          "message": "Generated protobuf code is not edited."
        }
      ]
    }
  },
  {
    "id": "c18-java-stdout",
    "title": "No System.out.println in Java code",
    "statement": "Java classes log through SLF4J. A new System.out.println call in a .java file is not allowed.",
    "examples": [
      {
