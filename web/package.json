{
  "name": "ipso-web",
  "private": true,
  "version": "0.0.0",
  "description": "The web app of the ipso control plane (IPSO-62).",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "fixtures": "vite --mode fixtures",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pact": "vitest run --config vitest.pact.config.ts",
    "api:types": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "node scripts/check-api-types.ts",
    "licenses": "node scripts/check-licenses.ts"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@pact-foundation/pact": "17.1.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
